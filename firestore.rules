rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // RuhGenesis community universes: anyone reads, signed-in (anonymous) users publish
    match /universes/{universeId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['id', 'name', 'seed'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && request.resource.data.seed is string
        && request.resource.data.seed.size() <= 200;
      allow update, delete: if false;
    }
  }
}
